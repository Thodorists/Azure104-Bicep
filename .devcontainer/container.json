{
  "name": "Azure & Terraform DevOps Codespace",
  "image": "://microsoft.com",
  
  # Εγκατάσταση των απαραίτητων εργαλείων (Features) κατά τη δημιουργία του Codespace
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    }
  },

  # Αυτόματη εγκατάσταση των επίσημων VS Code Extensions για καλύτερο development
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.PowerShell",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.azurecli",
        "HashiCorp.terraform"
      ]
    }
  },

  # Εκτέλεση εντολής ΑΜΕΣΩΣ μόλις δημιουργηθεί το Codespace (εγκατάσταση του Az Module στο PowerShell)
  "postCreateCommand": "pwsh -Command \"Install-Module -Name Az -Force -AllowClobber -Scope CurrentUser\""
}
