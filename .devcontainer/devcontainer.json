{
"name": "Azure 104 & Terraform Complete Lab",

"image": "mcr.microsoft.com/devcontainers/base:ubuntu",

"features": {
"ghcr.io/devcontainers/features/azure-cli:1": {},
"ghcr.io/devcontainers/features/terraform:1": {
"version": "latest"
},
"ghcr.io/devcontainers/features/powershell:1": {}
},

"customizations": {
"vscode": {
"extensions": [
"ms-vscode.PowerShell",
"ms-azuretools.vscode-bicep",
"ms-vscode.azurecli",
"HashiCorp.terraform"
]
}
},

"postCreateCommand": "pwsh -Command "Set-PSRepository -Name PSGallery -InstallationPolicy Trusted; Install-Module -Name Az -Force -Scope CurrentUser; az bicep install"",

"remoteUser": "vscode"
}
